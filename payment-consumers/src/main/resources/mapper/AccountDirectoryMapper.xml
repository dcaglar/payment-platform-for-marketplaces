<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.dogancaglar.paymentservice.infra.adapter.outbound.persistence.mapper.AccountDirectoryMapper">

    <!-- Column order must match the AccountProfile constructor: the ledger_accounts row, owner_code as the master
         account (a merchant or GLOBAL) and seller_code as the sub entity. -->
    <sql id="accountProfileColumns">
        account_code,
        ledger_type AS type,
        owner_code AS master_account_code,
        seller_code AS sub_entity_id,
        currency,
        status
    </sql>

    <!-- Platform-wide and per-merchant accounts (no sub entity) -->
    <select id="findByEntityAndType"
            parameterType="map"
            resultType="com.dogancaglar.paymentservice.domain.model.ledger.AccountProfile">
        SELECT
        <include refid="accountProfileColumns"/>
        FROM ledger_accounts
        WHERE ledger_type = #{accountType}
        AND owner_code = #{masterAccountCode}
        AND seller_code IS NULL
        AND currency = #{currency}
    </select>

    <!-- The account of one sub entity (seller) under a merchant -->
    <select id="findBySubEntity"
            parameterType="map"
            resultType="com.dogancaglar.paymentservice.domain.model.ledger.AccountProfile">
        SELECT
        <include refid="accountProfileColumns"/>
        FROM ledger_accounts
        WHERE ledger_type = #{accountType}
        AND owner_code = #{masterAccountCode}
        AND seller_code = #{subEntityId}
        AND currency = #{currency}
    </select>

    <!-- All accounts of one sub entity (seller), one row per currency -->
    <select id="findAllBySubEntity"
            parameterType="map"
            resultType="com.dogancaglar.paymentservice.domain.model.ledger.AccountProfile">
        SELECT
        <include refid="accountProfileColumns"/>
        FROM ledger_accounts
        WHERE ledger_type = #{accountType}
        AND seller_code = #{subEntityId}
        ORDER BY currency
    </select>

    <!-- All accounts of one merchant of one type (no sub entity), one row per currency -->
    <select id="findAllByMaster"
            parameterType="map"
            resultType="com.dogancaglar.paymentservice.domain.model.ledger.AccountProfile">
        SELECT
        <include refid="accountProfileColumns"/>
        FROM ledger_accounts
        WHERE ledger_type = #{accountType}
        AND owner_code = #{masterAccountCode}
        AND seller_code IS NULL
        ORDER BY currency
    </select>

    <!-- All accounts of one type of a merchant's sub entities (sellers), in natural order of the seller code
         (SELLER-5-2 before SELLER-5-10, collation natural_order in central-accounts.xml): stable paging -->
    <select id="findAllSubEntitiesByMaster"
            parameterType="map"
            resultType="com.dogancaglar.paymentservice.domain.model.ledger.AccountProfile">
        SELECT
        <include refid="accountProfileColumns"/>
        FROM ledger_accounts
        WHERE ledger_type = #{accountType}
        AND owner_code = #{masterAccountCode}
        AND seller_code IS NOT NULL
        ORDER BY seller_code COLLATE natural_order, currency
    </select>

    <select id="findByAccountCode"
            parameterType="string"
            resultType="com.dogancaglar.paymentservice.domain.model.ledger.AccountProfile">
        SELECT
        <include refid="accountProfileColumns"/>
        FROM ledger_accounts
        WHERE account_code = #{accountCode}
    </select>
</mapper>
