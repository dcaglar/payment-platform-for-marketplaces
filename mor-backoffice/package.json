{
  "name": "mor-backoffice",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Back office of the MoR payment platform: balances and transactions for sellers, merchants and staff",
  "scripts": {
    "dev": "run-p dev:server dev:web",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "build": "npm run typecheck && vite build"
  },
  "dependencies": {
    "express": "^4.22.3",
    "express-session": "^1.19.0",
    "openid-client": "^6.8.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "npm-run-all": "^4.1.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
