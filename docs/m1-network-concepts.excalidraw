  },
  {
   "id": "dirn",
   "type": "text",
   "x": 40,
   "y": 600,
   "width": 943.8000000000001,
   "height": 65.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 649821630,
   "version": 1,
   "versionNonce": 996247159,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1792081253201,
   "link": null,
   "locked": false,
   "text": "\"Open outbound\" = the connection was started from inside, so the router lets its replies back in.\nThere is no such thing as a closed outbound here; everything inside may call out.\n\"Open inbound\" would mean port forwarding on the router: a hole anyone on the internet can scan. We never do that.\nCloudflare Tunnel and Tailscale both use the same trick: the Mac calls OUT first, and the other side sends work back down that call.",
   "originalText": "\"Open outbound\" = the connection was started from inside, so the router lets its replies back in.\nThere is no such thing as a closed outbound here; everything inside may call out.\n\"Open inbound\" would mean port forwarding on the router: a hole anyone on the internet can scan. We never do that.\nCloudflare Tunnel and Tailscale both use the same trick: the Mac calls OUT first, and the other side sends work back down that call.",
   "fontSize": 13,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "baseline": 61.1,
   "autoResize": true
  },
