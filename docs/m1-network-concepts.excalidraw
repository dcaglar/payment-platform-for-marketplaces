  {
   "id": "gl",
   "type": "text",
   "x": 830,
   "y": 485,
   "width": 858.0000000000001,
   "height": 180.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1128488134,
   "version": 1,
   "versionNonce": 1210883261,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1792081253201,
   "link": null,
   "locked": false,
   "text": "domain        dc4pay.com - the name you bought. One domain, many hostnames.\nhostname      one full name for one service: api.dc4pay.com, auth.dc4pay.com. The visitor types a hostname.\nDNS           the lookup from a name to an address. A record = name -> IP address. CNAME record = name -> another name (an alias).\nauthoritative the DNS server that holds the official records for a domain. Everyone else just caches its answers.\nproxied CNAME a Cloudflare CNAME where the public answer is Cloudflare's IP; traffic flows through Cloudflare first.\nedge          Cloudflare's data centres spread around the world; the visitor always hits the nearest one.\nTLS / HTTPS   the encryption behind the padlock. 'Terminate TLS' = the place where it is decrypted (here: Cloudflare).\ncertificate   the file that proves 'this server really is dc4pay.com'. Universal cert = Cloudflare's free one, auto-renewed.\ntunnel        a connection opened outbound from your Mac and kept open; Cloudflare pushes requests down it.\ncloudflared   the program that opens the tunnel and holds its ingress rules (hostname -> where inside).\ningress rules cloudflared's table: hostname -> internal address. Not the same as a Kubernetes Ingress,\n              which is ingress-nginx's table: hostname + path -> pod.",
   "originalText": "domain        dc4pay.com - the name you bought. One domain, many hostnames.\nhostname      one full name for one service: api.dc4pay.com, auth.dc4pay.com. The visitor types a hostname.\nDNS           the lookup from a name to an address. A record = name -> IP address. CNAME record = name -> another name (an alias).\nauthoritative the DNS server that holds the official records for a domain. Everyone else just caches its answers.\nproxied CNAME a Cloudflare CNAME where the public answer is Cloudflare's IP; traffic flows through Cloudflare first.\nedge          Cloudflare's data centres spread around the world; the visitor always hits the nearest one.\nTLS / HTTPS   the encryption behind the padlock. 'Terminate TLS' = the place where it is decrypted (here: Cloudflare).\ncertificate   the file that proves 'this server really is dc4pay.com'. Universal cert = Cloudflare's free one, auto-renewed.\ntunnel        a connection opened outbound from your Mac and kept open; Cloudflare pushes requests down it.\ncloudflared   the program that opens the tunnel and holds its ingress rules (hostname -> where inside).\ningress rules cloudflared's table: hostname -> internal address. Not the same as a Kubernetes Ingress,\n              which is ingress-nginx's table: hostname + path -> pod.",
   "fontSize": 12,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "baseline": 176.4,
   "autoResize": true
  }
