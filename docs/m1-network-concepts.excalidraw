   "text": "INBOUND: started outside -> BLOCKED. Nobody can knock on the Mac's door.",
   "originalText": "INBOUND: started outside -> BLOCKED. Nobody can knock on the Mac's door.",
   "fontSize": 12,
   "fontFamily": 1,
