      "seed": 950280,
      "version": 1,
      "versionNonce": 958199,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Authorize — what the caller gets\nauthorized → ONE local tx: AUTHORIZED + outbox payment_authorized · 200\ncard declined → DECLINED (final) · 200\nPSP refused our request for good → FAILED (final) · 422\nPSP unavailable / outcome unknown → back to CREATED · 503 RETRY_LATER\nno answer in 3 s → 202 PENDING_AUTH + Location (background stores the answer)\nnot in this cell → 404 · CREATED_PENDING → 409 · already decided → current state",
      "originalText": "Authorize — what the caller gets\nauthorized → ONE local tx: AUTHORIZED + outbox payment_authorized · 200\ncard declined → DECLINED (final) · 200\nPSP refused our request for good → FAILED (final) · 422\nPSP unavailable / outcome unknown → back to CREATED · 503 RETRY_LATER\nno answer in 3 s → 202 PENDING_AUTH + Location (background stores the answer)\nnot in this cell → 404 · CREATED_PENDING → 409 · already decided → current state",
      "fontSize": 17,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "n2",
      "lineHeight": 1.25,
      "autoResize": true
    },
