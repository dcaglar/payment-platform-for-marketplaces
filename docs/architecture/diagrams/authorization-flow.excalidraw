    {
      "id": "n1_label",
      "type": "text",
      "x": 730.5,
      "y": 555.5,
      "width": 739,
      "height": 149,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 601844,
      "version": 1,
      "versionNonce": 609763,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Create — what the caller gets\nPSP answered → CREATED · 201 + Location { paymentIntentId, clientSecret }\nPSP refused our request for good → FAILED · 422\nPSP unavailable / outcome unknown → key released · 503 RETRY_LATER\nno answer in 3 s → 202 + Retry-After 2 (background stores the answer → CREATED)\nsame key again: other body → 422 KEY_REUSED · still running → 409 IN_PROGRESS\n· finished → replay of the first answer + Idempotent-Replayed",
      "originalText": "Create — what the caller gets\nPSP answered → CREATED · 201 + Location { paymentIntentId, clientSecret }\nPSP refused our request for good → FAILED · 422\nPSP unavailable / outcome unknown → key released · 503 RETRY_LATER\nno answer in 3 s → 202 + Retry-After 2 (background stores the answer → CREATED)\nsame key again: other body → 422 KEY_REUSED · still running → 409 IN_PROGRESS\n· finished → replay of the first answer + Idempotent-Replayed",
      "fontSize": 17,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "n1",
      "lineHeight": 1.25,
      "autoResize": true
    },
