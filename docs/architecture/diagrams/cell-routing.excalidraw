      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Snowflake Lua router «edge-infra»\n① match /api/v1/payments/pi_([A-Za-z0-9_%-]+)\n② Base64URL → 8-byte long\n③ nodeId = floor(lo / 4096) % 32   (= (id >> 12) & 31)\n④ proxy_pass → payment-edge-cell-<nodeId>",
      "originalText": "Snowflake Lua router «edge-infra»\n① match /api/v1/payments/pi_([A-Za-z0-9_%-]+)\n② Base64URL → 8-byte long\n③ nodeId = floor(lo / 4096) % 32   (= (id >> 12) & 31)\n④ proxy_pass → payment-edge-cell-<nodeId>",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "lua",
      "lineHeight": 1.25,
      "autoResize": true
    },
